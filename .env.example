APP_ENV=local
APP_NAME=AI Resume Platform
API_PREFIX=/api

POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_password
POSTGRES_DB=resume_db
DATABASE_URL=postgresql+psycopg2://resume_user:resume_password@postgres:5432/resume_db

JWT_SECRET_KEY=change_me_super_secret_key_for_local_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_PROVIDER=local_jwt

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# Storage provider (local-first, S3 ready)
STORAGE_PROVIDER=local
BACKEND_PUBLIC_URL=http://localhost:8080

# S3 (dùng chung cho MinIO/S3-compatible qua S3_ENDPOINT_URL)
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT_URL=
PRESIGN_EXPIRY_SECONDS=900

# SQS
SQS_QUEUE_NAME=ResumeMatching-Queue
SQS_QUEUE_URL=
SQS_DLQ_URL=
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=300

AI_PROVIDER=mock
AI_MODEL=mock-v1
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

ADMIN_EMAIL=nd3t@gmail.com
ADMIN_PASSWORD=20222026
ADMIN_FULL_NAME=NĐ-3T

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
